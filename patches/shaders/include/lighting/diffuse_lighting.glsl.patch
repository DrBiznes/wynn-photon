+// Wynn-Photon: strength of the vanilla light fallback. Every Wynncraft path is
+// lined with invisible light blocks, which vanilla barely shows in daylight,
+// so the fallback fades out on sky-lit blocks during the day. Caves (low
+// skylight) and the night keep all of it
+float wynn_vanilla_light_scale(float skylight) {
+#if defined WORLD_OVERWORLD
+    float daylight = 1.0 - time_midnight;
+    return WYNN_VANILLA_LIGHT_I
+        * (1.0 - daylight * linear_step(0.4, 0.8, skylight));
+#else
+    return WYNN_VANILLA_LIGHT_I;
+#endif
+}
+
 float get_skylight_falloff(float skylight) {
 #if defined WORLD_OVERWORLD
     return sqr(skylight);
