+// Wynn-Photon: height of a vertex above the bottom of its block, in blocks.
+// mid_block is Iris's at_midBlock: the offset to the block centre, in 1/64ths.
+float vertex_height_in_block(vec3 mid_block) {
+    return clamp(0.5 - mid_block.y * rcp(64.0), 0.0, 2.0);
+}
+
