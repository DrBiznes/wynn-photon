 uniform.bool.daylight_cycle_enabled = worldTime > smooth(worldTime, 0.1, 0.1)
 
+# Wynn-Photon: clock for the meteors in the night sky (include/sky/meteors.glsl). x is the time of the world's day in
+# seconds (0 to 1200), y the world day, z how much of the meteors shows by the hour and weather (all at night, none by
+# day or in rain) and w how much shows because the clock is steady.
+# The time follows the server's world time, so that players in one world see the same meteors, but it never runs on it:
+# world time comes in ticks and stutters with lag. It runs on frameTimeCounter plus an offset, which is the difference
+# between the two, eased over 20 seconds. The offset is eased as an angle (a day is one turn), so it doesn't mind
+# either clock wrapping around. Lag barely moves it; after a real change of time it glides to the new value, and the
+# meteors hide while it is more than 3 seconds off. Where time stands still, the clock is frameTimeCounter alone
+variable.float.wynn_sync_angle = (worldTime / 20.0 - frameTimeCounter) * 0.0052359878
+variable.float.wynn_sync_cos = smooth(cos(wynn_sync_angle), 20.0, 20.0)
+variable.float.wynn_sync_sin = smooth(sin(wynn_sync_angle), 20.0, 20.0)
+variable.float.wynn_sync_offset = atan2(wynn_sync_sin, wynn_sync_cos)
+variable.float.wynn_sync_error = abs(atan2(sin(wynn_sync_angle - wynn_sync_offset), cos(wynn_sync_angle - wynn_sync_offset))) * 190.98593
