+// Wynn-Photon: the distance to the cloud for world effects.
+//
+// WynnVista draws its world effects (the Mount Wynn smoke plume and others) over the finished image, and reads the
+// clouds history to put them behind the clouds. The apparent distance Photon keeps in clouds_data.x does not serve
+// for that along a cloud's edge or beside terrain: "no cloud" is a huge distance that the filtering over space and
+// time mixes in, and over terrain it is the distance to only the part of the cloud in front of the terrain, which
+// the history carries into the sky pixels beside it. An effect behind such a pixel flickered in and out of the
+// cloud. Photon's own use of clouds_data.x is not affected by either, so that component is left as it is and a
+// distance of its own is kept for the effects in clouds_data.w:
+//  - 0 where there is no cloud, and on terrain
+//  - a sky pixel's distance changes only in the frames in which that very pixel is marched, and not by a march
+//    that terrain beside the pixel cut short: a march that finds a cloud is blended into the distance kept, or
+//    taken as it is when none is kept or the two are far apart (another cloud); after a march that finds none,
+//    the distance is dropped once the clouds image kept for the pixel has let go of the cloud as well
+//  - a sky pixel that holds no distance, while the clouds image kept for it has a cloud, takes that of the march
+//    beside it until its own comes (the pixels are marched in turn, each once in 16 frames)
+const float clouds_no_distance = 1e5; // an apparent distance beyond this means "no cloud"
+
+// The history's distance for effects between four texels, like texture(), without the texels that hold none
+float texture_effect_distance(sampler2D s, vec2 coord) {
+    vec2 f = fract(coord * vec2(textureSize(s, 0)) - 0.5);
+    vec4 distances = textureGather(s, coord, 3);
+    vec4 weights = vec4(
+        (1.0 - f.x) * f.y,
+        f.x * f.y,
+        f.x * (1.0 - f.y),
+        (1.0 - f.x) * (1.0 - f.y)
+    ) * step(0.5, distances);
+    float weight_sum = weights.x + weights.y + weights.z + weights.w;
+
+    // None where most of what is filtered holds none: otherwise the distances would spread into the clear sky
+    // around a cloud, a texel further each frame
+    return weight_sum > 0.5 ? dot(weights, distances) / weight_sum : 0.0;
+}
+
+// The furthest depth in the area that d1_clouds looks at for the march at march_uv (its depth_max_4x4)
+float march_depth_max(sampler2D depth_sampler, vec2 march_uv, float scale) {
+    vec2 coord = march_uv * scale;
+    vec2 offset = 2.0 * view_pixel_size;
+
+    return max(
+        max(max_of(textureGather(depth_sampler, coord + offset)),
+            max_of(textureGather(depth_sampler, coord + vec2(-offset.x, offset.y)))),
+        max(max_of(textureGather(depth_sampler, coord + vec2(offset.x, -offset.y))),
+            max_of(textureGather(depth_sampler, coord - offset)))
+    );
+}
