+        // Only the march of this very pixel counts: a march beside it can be of another cloud, much nearer
+        // or further, and the distance would jump with whichever pixel was marched
+        if (!marched_cloud) {
+            // The image lets through as much as a march without a cloud did: all but the crepuscular rays
+            if (clouds_history.a > 0.99 * marched_transmittance) {
+                effect_distance = 0.0;
+            }
+        } else if (effect_distance_history < 0.5
+            || max(marched_distance, effect_distance_history)
+                > 1.5 * min(marched_distance, effect_distance_history)) {
+            effect_distance = marched_distance;
+        } else {
+            effect_distance
+                = mix(marched_distance, effect_distance_history, 0.75);
+        }
+    } else if (effect_distance_history < 0.5 && marched_cloud
+        && !march_cut_short && clouds_history.a < 0.9) {
+        // A cloud is in the image kept for this pixel, which holds no distance for it yet: its own march can be
+        // 16 frames away, and an effect would show through the cloud until then. The march beside it stands in.
+        // It cannot make a distance jump, since there is none to change
+        effect_distance = marched_distance;
+    }
+    clouds_data.w = min(effect_distance, 6e4); // within what the buffer's format holds
