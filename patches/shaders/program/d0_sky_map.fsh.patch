+layout(location = 0) out vec4 wynn_sky_map_out;
+vec3 sky_map;
+// Wynn-Photon: set by get_clouds_and_aurora in sky.glsl, in the Overworld only
+float wynn_clouds_transmittance = 1.0;
 
 /* RENDERTARGETS: 4 */
 
@@ -163,4 +168,7 @@
         sky_map = sky_map * fog[1] + fog[0];
 #endif
     }
+
+    // Wynn-Photon: the sky map, and the clouds' transmittance in alpha
+    wynn_sky_map_out = vec4(sky_map, wynn_clouds_transmittance);
 }
