* text=auto eol=lf
*.jar binary

#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf


# Patches are unified diffs: keep LF and every byte of whitespace as is
/patches/** text eol=lf
